    {
      "parameters": {
        "jsCode": "const v = $('Validate').first().json;\nconst read = name => { try { const x = $(name).first(); return x && x.json ? x.json : {}; } catch (e) { return {}; } };\nlet ok = false, error = null, detail = null, bundleStatus = null;\nif (v.branch === \"SET\" || v.branch === \"UNDO\") {\n  // Apply to Yext returns nothing on success when notify is NONE, so the bundle status read afterwards decides.\n  const res = read(v.branch === \"SET\" ? \"Run Apply\" : \"Run Undo\");\n  bundleStatus = read(\"Read Status\").status || null;\n  const want = v.branch === \"SET\" ? \"APPLIED\" : \"UNDONE\";\n  if (res.status === \"SKIPPED_GUARD\") error = res.error || \"SKIPPED\";\n  else if (bundleStatus === want && (!res.status || res.status === \"SUCCESS\")) ok = true;\n  else { error = v.branch === \"SET\" ? \"APPLY_FAILED\" : \"UNDO_FAILED\"; detail = res.error || (\"bundle status \" + bundleStatus); }\n} else if (v.branch === \"PERMISSION\") {\n  const r = read(\"Set has_permission\");\n  ok = !r.error;\n  if (!ok) { error = \"WRITE_FAILED\"; detail = String(r.error.message || r.error); }\n} else {\n  ok = true; // DECLINE: nothing is written to the item, so the date is never sent to Yext.\n}\nreturn [{ json: {\n  ok, error, detail, action: v.action, branch: v.branch, bundle_id: v.bundle_id, entity_id: v.entity_id,\n  date: v.date, hours: v.hours, item_id: v.item_id, bundle_status: bundleStatus,\n  // A failed write must not leave its hours behind; a successful undo puts the date back in the deck.\n  clear_date: (v.branch === \"UNDO\" && ok) || (v.branch === \"SET\" && !ok),\n} }];\n"
      },
