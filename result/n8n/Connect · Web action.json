    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst ACTIONS = [\"APPROVE\", \"EDIT\", \"REGULAR\", \"DECLINE\", \"UNDO\", \"PERMISSION\", \"REVOKE\"];\nconst SET_ACTIONS = [\"APPROVE\", \"EDIT\", \"REGULAR\"];\nconst action = String(body.action || \"\").trim().toUpperCase();\nconst bundleId = String(body.bundle_id || \"\").trim();\nconst entityId = String(body.entity_id || \"\").trim();\nconst bundle = $('Get Bundle').all().map(i => i.json).find(b => b && b.bundle_id === bundleId) || null;\nconst items = $('Get Items').all().map(i => i.json).filter(i => i && i.bundle_id === bundleId);\nconst fail = code => [{ json: { valid: false, ok: false, error: code, action, bundle_id: bundleId } }];\n\nconst pad = n => String(n).padStart(2, \"0\");\n// Same rules as the Validate node in Connect · Parse edit: closed, regular, or HH:MM-HH:MM intervals with start < end.\nfunction normHours(h) {\n  const s = String(h ?? \"\").trim().toLowerCase().replace(/[–—]/g, \"-\").replace(/\\s+/g, \"\");\n  if (s === \"closed\") return \"closed\";\n  if (s === \"regular\") return \"regular\";\n  const out = [];\n  for (const p of s.split(\",\")) {\n    const m = p.match(/^(\\d{1,2})[:.](\\d{2})-(\\d{1,2})[:.](\\d{2})$/);\n    if (!m) return null;\n    const h1 = Number(m[1]), m1 = Number(m[2]), h2 = Number(m[3]), m2 = Number(m[4]);\n    if (h1 > 24 || h2 > 24 || m1 > 59 || m2 > 59) return null;\n    if ((h1 === 24 && m1 > 0) || (h2 === 24 && m2 > 0)) return null;\n    if (h1 * 60 + m1 >= h2 * 60 + m2) return null;\n    out.push(pad(h1) + \":\" + pad(m1) + \"-\" + pad(h2) + \":\" + pad(m2));\n  }\n  return out.length ? out.join(\",\") : null;\n}\n\nif (!ACTIONS.includes(action)) return fail(\"BAD_ACTION\");\nif (!bundleId) return fail(\"BAD_BUNDLE\");\nif (!bundle) return fail(\"BUNDLE_NOT_FOUND\");\nif (entityId && bundle.entity_id !== entityId) return fail(\"ENTITY_MISMATCH\");\nconst route = String(bundle.route || \"\").toUpperCase();\nif (![\"SUGGEST\", \"ASK\", \"AUTO_APPLY\"].includes(route)) return fail(\"ROUTE_\" + (route || \"NONE\"));\n// A write that started less than 10 minutes ago is still running: answer BUSY instead of starting a second one.\nconst startedAt = bundle.updated_at ? new Date(bundle.updated_at).getTime() : 0;\nif (bundle.status === \"APPLYING\" && Date.now() - startedAt <= 10 * 60000) return fail(\"BUSY\");\n\nlet date = null, hours = null, item = null;\nif (action !== \"PERMISSION\" && action !== \"REVOKE\") {\n  date = String(body.date || \"\").slice(0, 10);\n  item = items.find(i => String(i.date).slice(0, 10) === date) || null;\n  if (!item) return fail(\"BAD_DATE\");\n}\nif (SET_ACTIONS.includes(action)) {\n  hours = normHours(action === \"REGULAR\" ? (body.hours || \"regular\") : body.hours);\n  if (!hours || (action === \"REGULAR\" && hours !== \"regular\")) return fail(\"BAD_HOURS\");\n}\nreturn [{ json: {\n  valid: true, ok: null, error: null, action,\n  // Undoing a decline only logs UNDO: nothing reached Yext, and an Apply UNDO would revert another date's write.\n  branch: SET_ACTIONS.includes(action) ? \"SET\" : (action === \"UNDO\" && String(body.undo_of || \"\").toUpperCase() === \"DECLINE\") ? \"DECLINE\" : action === \"REVOKE\" ? \"PERMISSION\" : action,\n  // PERMISSION turns automatic updates on, REVOKE turns them off again (same node, opposite value).\n  permission_value: action === \"PERMISSION\" ? \"true\" : action === \"REVOKE\" ? \"false\" : null,\n  bundle_id: bundleId, entity_id: bundle.entity_id, date, hours,\n  item_id: item ? item.id : null, status_before: bundle.status,\n} }];\n"
      },
