    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const DICT = {\n \"btn_approve\":{\"fi\":\"✅ Hyväksy\",\"sv\":\"✅ Godkänn\",\"nb\":\"✅ Godkjenn\",\"en\":\"✅ Approve\"},\n \"btn_edit\":{\"fi\":\"✏️ Muokkaa\",\"sv\":\"✏️ Ändra\",\"nb\":\"✏️ Endre\",\"en\":\"✏️ Edit\"},\n \"btn_decline\":{\"fi\":\"❌ Ei kiitos\",\"sv\":\"❌ Nej tack\",\"nb\":\"❌ Nei takk\",\"en\":\"❌ No thanks\"},\n \"btn_confirm\":{\"fi\":\"✅ Vahvista\",\"sv\":\"✅ Bekräfta\",\"nb\":\"✅ Bekreft\",\"en\":\"✅ Confirm\"},\n \"btn_cancel\":{\"fi\":\"↩️ Peruuta\",\"sv\":\"↩️ Avbryt\",\"nb\":\"↩️ Avbryt\",\"en\":\"↩️ Cancel\"},\n \"btn_closed\":{\"fi\":\"🔒 Kiinni\",\"sv\":\"🔒 Stängt\",\"nb\":\"🔒 Stengt\",\"en\":\"🔒 Closed\"},\n \"btn_regular\":{\"fi\":\"🕘 Normaalisti auki\",\"sv\":\"🕘 Öppet som vanligt\",\"nb\":\"🕘 Åpent som vanlig\",\"en\":\"🕘 Open as usual\"},\n \"btn_undo\":{\"fi\":\"↩️ Peru muutos\",\"sv\":\"↩️ Ångra\",\"nb\":\"↩️ Angre\",\"en\":\"↩️ Undo\"},\n \"btn_permission_yes\":{\"fi\":\"🤝 Hoida jatkossa\",\"sv\":\"🤝 Sköt det framöver\",\"nb\":\"🤝 Ordne det fremover\",\"en\":\"🤝 Handle it from now on\"},\n \"btn_not_now\":{\"fi\":\"Ei nyt\",\"sv\":\"Inte nu\",\"nb\":\"Ikke nå\",\"en\":\"Not now\"},\n \"btn_retry\":{\"fi\":\"🔁 Yritä uudelleen\",\"sv\":\"🔁 Försök igen\",\"nb\":\"🔁 Prøv igjen\",\"en\":\"🔁 Try again\"},\n \"label_closed\":{\"fi\":\"suljettu\",\"sv\":\"stängt\",\"nb\":\"stengt\",\"en\":\"closed\"},\n \"label_regular\":{\"fi\":\"normaalit aukioloajat\",\"sv\":\"ordinarie öppettider\",\"nb\":\"vanlige åpningstider\",\"en\":\"regular hours\"},\n \"msg_edit_prompt\":{\"fi\":\"Miten haluat muuttaa? Kirjoita vapaasti, esim. \\\"26.12. auki 10–14\\\", tai valitse alta.\",\"sv\":\"Hur vill du ändra? Skriv fritt, t.ex. \\\"26.12 öppet 10–14\\\", eller välj nedan.\",\"nb\":\"Hvordan vil du endre? Skriv fritt, f.eks. \\\"26.12 åpent 10–14\\\", eller velg nedenfor.\",\"en\":\"How would you like to change it? Type freely, e.g. \\\"26 Dec open 10–14\\\", or pick below.\"},\n \"msg_confirm_title\":{\"fi\":\"Tarkista muutokset:\",\"sv\":\"Kontrollera ändringarna:\",\"nb\":\"Sjekk endringene:\",\"en\":\"Please check the changes:\"},\n \"msg_clarify\":{\"fi\":\"En ollut varma, mitä tarkoitit. Kirjoita päivä ja aika, esim. \\\"26.12. kiinni\\\" tai \\\"31.12. 10–14\\\".\",\"sv\":\"Jag förstod inte riktigt. Skriv datum och tid, t.ex. \\\"26.12 stängt\\\" eller \\\"31.12 10–14\\\".\",\"nb\":\"Jeg forsto ikke helt. Skriv dato og tid, f.eks. \\\"26.12 stengt\\\" eller \\\"31.12 10–14\\\".\",\"en\":\"I wasn't sure what you meant. Write the date and time, e.g. \\\"26 Dec closed\\\" or \\\"31 Dec 10–14\\\".\"},\n \"msg_bad_time\":{\"fi\":\"Sulkemisajan pitää olla avaamisen jälkeen. Kokeile uudelleen.\",\"sv\":\"Stängningstiden måste vara efter öppningstiden. Försök igen.\",\"nb\":\"Stengetiden må være etter åpningstiden. Prøv igjen.\",\"en\":\"The closing time must be after the opening time. Please try again.\"},\n \"msg_bad_date\":{\"fi\":\"Päivä ei kuulu tähän ehdotukseen ({dates}).\",\"sv\":\"Datumet ingår inte i förslaget ({dates}).\",\"nb\":\"Datoen er ikke med i forslaget ({dates}).\",\"en\":\"That date is not part of this suggestion ({dates}).\"},\n \"msg_applied\":{\"fi\":\"✅ Päivitetty! Uudet ajat näkyvät pian:\",\"sv\":\"✅ Uppdaterat! De nya tiderna syns snart på:\",\"nb\":\"✅ Oppdatert! De nye tidene vises snart på:\",\"en\":\"✅ Updated! Your new hours will show on:\"},\n \"msg_auto_applied\":{\"fi\":\"🤖 Päivitimme juhlapyhien aukioloajat luvallasi:\",\"sv\":\"🤖 Vi uppdaterade öppettiderna för helgdagar med ditt tillstånd:\",\"nb\":\"🤖 Vi oppdaterte åpningstidene for helligdager med din tillatelse:\",\"en\":\"🤖 We updated your holiday hours with your permission:\"},\n \"msg_apply_failed\":{\"fi\":\"⚠️ Päivitys ei onnistunut. Mitään ei muutettu. Tiimimme on saanut tiedon.\",\"sv\":\"⚠️ Uppdateringen gick inte igenom. Inget har ändrats. Vårt team har informerats.\",\"nb\":\"⚠️ Oppdateringen gikk ikke gjennom. Ingenting er endret. Teamet vårt er varslet.\",\"en\":\"⚠️ The update didn't go through. Nothing was changed. Our team has been notified.\"},\n \"msg_undone\":{\"fi\":\"↩️ Muutos peruttu. Aiemmat ajat ovat taas voimassa.\",\"sv\":\"↩️ Ändringen är ångrad. De tidigare tiderna gäller igen.\",\"nb\":\"↩️ Endringen er angret. De tidligere tidene gjelder igjen.\",\"en\":\"↩️ Change undone. Your previous hours are back.\"},\n \"msg_declined\":{\"fi\":\"Selvä, emme muuta mitään. Oletteko silloin auki normaalisti?\",\"sv\":\"Okej, vi ändrar ingenting. Har ni öppet som vanligt då?\",\"nb\":\"Greit, vi endrer ingenting. Har dere åpent som vanlig da?\",\"en\":\"OK, we won't change anything. Will you be open as usual on those days?\"},\n \"msg_permission_offer\":{\"fi\":\"Hoidetaanko juhlapyhät jatkossa puolestasi? Saat aina ilmoituksen ja voit perua.\",\"sv\":\"Ska vi sköta helgdagarna åt dig framöver? Du får alltid besked och kan ångra.\",\"nb\":\"Skal vi ordne helligdagene for deg fremover? Du får alltid beskjed og kan angre.\",\"en\":\"Shall we handle holidays for you from now on? You'll always be notified and can undo.\"},\n \"msg_permission_granted\":{\"fi\":\"🤝 Kiitos! Hoidamme juhlapyhät jatkossa ja ilmoitamme aina.\",\"sv\":\"🤝 Tack! Vi sköter helgdagarna framöver och meddelar dig alltid.\",\"nb\":\"🤝 Takk! Vi ordner helligdagene fremover og gir deg alltid beskjed.\",\"en\":\"🤝 Thanks! We'll handle holidays from now on and always let you know.\"},\n \"msg_already_handled\":{\"fi\":\"Tämä ehdotus on jo käsitelty.\",\"sv\":\"Det här förslaget är redan hanterat.\",\"nb\":\"Dette forslaget er allerede behandlet.\",\"en\":\"This suggestion has already been handled.\"},\n \"msg_cancelled\":{\"fi\":\"Muokkaus peruttu. Alkuperäinen ehdotus on yhä voimassa.\",\"sv\":\"Ändringen avbröts. Det ursprungliga förslaget gäller.\",\"nb\":\"Endringen ble avbrutt. Det opprinnelige forslaget gjelder.\",\"en\":\"Edit cancelled. The original suggestion still stands.\"},\n \"msg_help\":{\"fi\":\"Hei! Lähetän ehdotuksia aukioloajoistasi. Vastaa napeilla tai kirjoittamalla.\",\"sv\":\"Hej! Jag skickar förslag om dina öppettider. Svara med knapparna eller skriv.\",\"nb\":\"Hei! Jeg sender forslag om åpningstidene dine. Svar med knappene eller skriv.\",\"en\":\"Hi! I send suggestions about your opening hours. Answer with the buttons or by typing.\"},\n \"msg_staff_flag\":{\"en\":\"🚩 Needs review: {business_name} ({entity_id}). {text}\"},\n \"msg_staff_error\":{\"en\":\"⚠️ Yext write failed for {business_name} ({entity_id}), bundle {bundle_id}: {error}\"}\n};\n\nconst inp = $json;\nconst lang = [\"fi\", \"sv\", \"nb\", \"en\"].includes(inp.language) ? inp.language : \"en\";\nconst params = (inp.params && typeof inp.params === \"object\") ? inp.params : {};\n\nfunction pick(key) {\n  const entry = key ? DICT[key] : null;\n  if (!entry) return null;\n  return entry[lang] ?? entry.en ?? null;\n}\n\nfunction fill(s) {\n  return String(s).replace(/\\{(@?\\w+)\\}/g, (m, k) => {\n    if (k.charAt(0) === \"@\") { const t = pick(k.slice(1)); return t === null ? m : fill(t); }\n    return (params[k] !== undefined && params[k] !== null) ? String(params[k]) : m;\n  });\n}\n\nfunction esc(s) {\n  return String(s)\n    .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\")\n    .replace(/&lt;(\\/?)b&gt;/g, \"<$1b>\");\n}\n\nlet main = pick(inp.key);\nif (main === null) main = (inp.text !== null && inp.text !== undefined) ? String(inp.text) : \"\";\nmain = fill(main);\n\nlet lines = Array.isArray(inp.lines) ? inp.lines.filter(l => l !== null && l !== undefined && String(l) !== \"\") : [];\nif (typeof inp.lines === \"string\" && inp.lines) lines = [inp.lines];\nlet html = esc(main);\nif (lines.length) html += (html ? \"\\n\\n\" : \"\") + lines.map(l => esc(fill(l))).join(\"\\n\");\nif (!html) html = esc(pick(\"msg_help\") || \"\");\n\nconst buttons = (Array.isArray(inp.buttons) ? inp.buttons : []).filter(b => b && b.key && b.data).slice(0, 3);\nconst hasButtons = buttons.length > 0;\nconst out = {\n  chat_id: String(inp.chat_id ?? \"\"),\n  html,\n  has_buttons: hasButtons,\n  n_buttons: buttons.length,\n  edit_message_id: (inp.edit_message_id === null || inp.edit_message_id === undefined || inp.edit_message_id === \"\") ? \"\" : String(inp.edit_message_id),\n};\nfor (let i = 0; i < 3; i++) {\n  const b = hasButtons ? buttons[i] : null;\n  out[\"b\" + (i + 1) + \"_text\"] = b ? (pick(b.key) || String(b.key)) : \"\";\n  out[\"b\" + (i + 1) + \"_data\"] = b ? String(b.data) : \"\";\n}\nreturn { json: out };"
      },
